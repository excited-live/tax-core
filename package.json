{
	"name": "@excited-live/tax",
	"version": "0.1.0",
	"description": "Pure, multi-jurisdiction individual income tax engine (TH 2026, US placeholder)",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/excited-live/tax-core.git"
	},
	"packageManager": "bun@1.3.14",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsup",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test && bun run build"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	}
}
