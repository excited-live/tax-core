{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!**/dist", "!**/coverage", "!**/*.md"] },
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"useLiteralKeys": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useImportType": "error",
				"useExportType": "error"
			},
			"suspicious": {
				"noExplicitAny": "error",
				"noImplicitAnyLet": "error"
			}
		}
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
